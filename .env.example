# GEMINI_API_KEY: Required on the server (Vercel / Node) for AI custom-context excuse rewrites.
# Leave unset or empty to run purely on the 288-template local JSON dataset.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (optional): Override the default Gemini model used by /api/excuse.
# Defaults to "gemini-4-hydrogen".
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL (optional): Public base URL (e.g. https://your-app.vercel.app).
# Used by Express server.ts for dynamic /robots.txt and /sitemap.xml generation.
APP_URL="MY_APP_URL"
